    "#pattern task\n",
    "#Input=5\n",
    "x=int(input( \"Enter a number for # pattern\"))\n",
    "for i in range(x+1):\n",
    "    for j in range(x-i):\n",
    "        print(\" \",end=\"\")\n",
    "    for j in range(i):\n",
    "        print(\"#\",end=\"\")\n",
    "    print()\n",
    "        \n"
   ]
